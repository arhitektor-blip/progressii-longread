        <mxCell id="n38" value="a₁ = 2, d = 3 → a₅ = 14" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="538" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n39" value="Характерист. свойство&lt;br&gt;&lt;font color=&quot;#B93B61&quot; style=&quot;font-size:14px&quot;&gt;aₙ = (aₙ₋₁ + aₙ₊₁)/2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCE7EF;strokeColor=#E4557E;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="609" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n40" value="Среднее арифм. соседей" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="602" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n41" value="Проверка: это АП или нет" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="666" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n42" value="Сумма первых n членов&lt;br&gt;&lt;font color=&quot;#B93B61&quot; style=&quot;font-size:14px&quot;&gt;Sₙ = (a₁ + aₙ)·n / 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCE7EF;strokeColor=#E4557E;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="737" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n43" value="Sₙ = (2a₁ + (n−1)d)·n/2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="730" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n44" value="Метод Гаусса: пары" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="794" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n45" value="Якорный пример&lt;br&gt;&lt;font color=&quot;#B93B61&quot; style=&quot;font-size:14px&quot;&gt;2, 5, 8, 11, 14, …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCE7EF;strokeColor=#E4557E;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="897" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n46" value="d = 3, растёт на три" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="858" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n47" value="a₁₀ = 2 + 9·3 = 29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="922" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n48" value="8 = (5 + 11)/2 ✓" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="986" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n49" value="ГЕОМЕТРИЧЕСКАЯ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#FFFFFFEE&quot;&gt;каждый раз умножаем на q&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#17A79B;strokeColor=none;fontColor=#FFFFFF;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1819" y="1571" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="n50" value="Определение&lt;br&gt;&lt;font color=&quot;#0E7C73&quot; style=&quot;font-size:14px&quot;&gt;bₙ₊₁ = bₙ · q,  q ≠ 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E2F4F2;strokeColor=#17A79B;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="1187" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n51" value="Знаменатель q&lt;br&gt;&lt;font color=&quot;#0E7C73&quot; style=&quot;font-size:14px&quot;&gt;q = bₙ₊₁ / bₙ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E2F4F2;strokeColor=#17A79B;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="1347" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n52" value="q &amp;gt; 1 — взрывной рост" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1308" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n53" value="0 &amp;lt; q &amp;lt; 1 — затухание" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1372" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n54" value="q &amp;lt; 0 — знаки чередуются" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1436" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n55" value="Формула n-го члена&lt;br&gt;&lt;font color=&quot;#0E7C73&quot; style=&quot;font-size:14px&quot;&gt;bₙ = b₁ · qⁿ⁻¹&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E2F4F2;strokeColor=#17A79B;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="1539" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n56" value="Нужно знать b₁ и q" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1500" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n57" value="По любым двум членам" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1564" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n58" value="1, 2, 4, 8, …: b₄ = 8" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1628" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n59" value="Характерист. свойство&lt;br&gt;&lt;font color=&quot;#0E7C73&quot; style=&quot;font-size:14px&quot;&gt;bₙ² = bₙ₋₁ · bₙ₊₁&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E2F4F2;strokeColor=#17A79B;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="1699" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n60" value="Среднее геом. соседей" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1692" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n61" value="Проверка: это ГП или нет" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="1756" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n62" value="Сумма первых n членов&lt;br&gt;&lt;font color=&quot;#0E7C73&quot; style=&quot;font-size:14px&quot;&gt;Sₙ = b₁(qⁿ − 1)/(q − 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E2F4F2;strokeColor=#17A79B;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="1827" width="392" height="96" as="geometry"/></mxCell>
