        <mxCell id="n28" value="Тренажёр в лонгриде" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="92" y="1660" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n29" value="АРИФМЕТИЧЕСКАЯ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#FFFFFFEE&quot;&gt;каждый раз прибавляем d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E4557E;strokeColor=none;fontColor=#FFFFFF;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1819" y="513" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="n30" value="Определение&lt;br&gt;&lt;font color=&quot;#B93B61&quot; style=&quot;font-size:14px&quot;&gt;aₙ₊₁ = aₙ + d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCE7EF;strokeColor=#E4557E;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="97" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n31" value="Разность d&lt;br&gt;&lt;font color=&quot;#B93B61&quot; style=&quot;font-size:14px&quot;&gt;d = aₙ₊₁ − aₙ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCE7EF;strokeColor=#E4557E;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="257" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n32" value="d &amp;gt; 0 — растёт" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="218" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n33" value="d &amp;lt; 0 — убывает" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="282" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n34" value="d = 0 — все члены равны" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="346" width="290" height="46" as="geometry"/></mxCell>
        <mxCell id="n35" value="Формула n-го члена&lt;br&gt;&lt;font color=&quot;#B93B61&quot; style=&quot;font-size:14px&quot;&gt;aₙ = a₁ + (n − 1)·d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCE7EF;strokeColor=#E4557E;fontColor=#23262E;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2234" y="449" width="392" height="96" as="geometry"/></mxCell>
        <mxCell id="n36" value="Нужно знать a₁ и d" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#D9DEE8;fontColor=#23262E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2706" y="410" width="290" height="46" as="geometry"/></mxCell>
